{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Lantern": "Debug"
    }
  },
  "Meilisearch": {
    "Url": "http://127.0.0.1:7700",
    "IndexName": "lantern-dev-documents"
  },
  "MeilisearchProcess": {
    "Managed": true,
    "Port": 7700,
    "BindAddress": "127.0.0.1",
    "FailOnStartupError": false
  },
  "Embedding": {
    "Port": 7703
  },
  "HybridSearch": {
    "ChunkIndexName": "lantern-dev-chunks"
  }
}
