{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Meilisearch": {
    "Url": "http://127.0.0.1:7700",
    "IndexName": "lantern-documents",
    "MaxDocumentsPerBatch": 100,
    "MaxPayloadBytesPerBatch": 4194304,
    "TaskTimeoutSeconds": 60
  },
  "Embedding": {
    "Enabled": false,
    "ModelPath": "resources/granite-embedding-97M-multilingual-r2.gguf",
    "ListenAddress": "127.0.0.1",
    "Port": 7701,
    "ContextSize": 4096,
    "Threads": 4,
    "InferenceWorkers": 1,
    "QueueCapacity": 32,
    "RequestTimeoutSeconds": 60
  },
  "Chunking": {
    "TargetTokens": 512,
    "MaxTokens": 768,
    "OverlapTokens": 64
  },
  "HybridSearch": {
    "Enabled": false,
    "EmbedderName": "lantern-granite",
    "ChunkIndexName": "lantern-chunks",
    "SemanticRatio": 0.5
  }
}
