@page "/admin"
@page "/admin/index"
@page "/admin/system"
@using System.Diagnostics
@using System.Runtime.InteropServices
@inject AdministrationService Administration
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment
@inject ILogger<Status> Logger

<PageTitle>@Title · Lantern Administration</PageTitle>
<h1>@Title</h1>
@if (_error)
{
    <p class="alert alert-danger" role="alert">System information could not be loaded. Check the server logs and database access.</p>
}
else if (_health != null)
{
    <h2 class="h5 mt-4">Search Engine</h2>
    <dl class="row">
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@_health.Message</dd>
        <dt class="col-sm-3">Active index</dt><dd class="col-sm-9">@_health.IndexName</dd>
        <dt class="col-sm-3">Indexed documents</dt><dd class="col-sm-9">@(_health.DocumentCount?.ToString("N0") ?? "Unavailable")</dd>
    </dl>
    <form method="post" action="/admin/actions/test-connection" data-enhance="false">
        <AntiforgeryToken />
        <button class="btn btn-outline-primary" type="submit">Test connection</button>
    </form>
    <h2 class="h5 mt-4">Application</h2>
    <dl class="row">
        <dt class="col-sm-3">Version</dt><dd class="col-sm-9">@typeof(Program).Assembly.GetName().Version</dd>
        <dt class="col-sm-3">Environment</dt><dd class="col-sm-9">@Environment.EnvironmentName</dd>
        <dt class="col-sm-3">Uptime</dt><dd class="col-sm-9">@Uptime</dd>
        <dt class="col-sm-3">Database</dt><dd class="col-sm-9">@(_database ? "Available" : "Unavailable")</dd>
        <dt class="col-sm-3">Runtime</dt><dd class="col-sm-9">@RuntimeInformation.FrameworkDescription</dd>
    </dl>
}

@code {
    private SearchEngineStatus? _health;
    private bool _database;
    private bool _error;
    private string Title => Navigation.Uri.Split('?', '#')[0].TrimEnd('/').Split('/').Last() switch
    { "index" => "Search Index", "system" => "System Status", _ => "Overview" };
    private static string Uptime
    {
        get
        {
            using var process = Process.GetCurrentProcess();
            return (DateTimeOffset.UtcNow - new DateTimeOffset(process.StartTime.ToUniversalTime())).ToString(@"d\.hh\:mm\:ss");
        }
    }
    protected override async Task OnInitializedAsync()
    {
        try { _database = await Administration.DatabaseAvailableAsync(); _health = await Administration.GetHealthAsync(); }
        catch (Exception ex) when (ex is not UnauthorizedAccessException)
        { Logger.LogError("Unable to load administration status ({ErrorType})", ex.GetType().Name); _error = true; }
    }
}
