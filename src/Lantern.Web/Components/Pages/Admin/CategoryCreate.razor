@page "/admin/categories/create"
@rendermode InteractiveServer
@using Lantern.Core.Administration
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav

<PageTitle>New Category · Lantern Administration</PageTitle>
<h1>New Search Category</h1>

@if (_saveError != null)
{
    <div class="alert alert-danger" role="alert">@_saveError</div>
}

<EditForm Model="_model" OnValidSubmit="SaveAsync" class="mt-3" style="max-width:36rem">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label" for="name">Name <span class="text-danger">*</span></label>
        <InputText id="name" class="form-control" @bind-Value="_model.Name" />
        <ValidationMessage For="() => _model.Name" class="text-danger small" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="key">Key <span class="text-danger">*</span></label>
        <InputText id="key" class="form-control font-monospace" @bind-Value="_model.Key" placeholder="research-papers" />
        <div class="form-text">URL-friendly identifier: lowercase letters, digits, and hyphens. Cannot be changed after creation.</div>
        <ValidationMessage For="() => _model.Key" class="text-danger small" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="description">Description</label>
        <InputTextArea id="description" class="form-control" @bind-Value="_model.Description" rows="2" />
        <ValidationMessage For="() => _model.Description" class="text-danger small" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="sortOrder">Sort Order</label>
        <InputNumber id="sortOrder" class="form-control" @bind-Value="_model.SortOrder" />
    </div>

    <div class="mb-3">
        <div class="form-check">
            <InputCheckbox id="enabled" class="form-check-input" @bind-Value="_model.Enabled" />
            <label class="form-check-label" for="enabled">Enabled</label>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Saving\u2026" : "Save")</button>
        <a href="/admin/categories" class="btn btn-outline-secondary">Cancel</a>
    </div>
</EditForm>

@code {
    [Inject] private CategoryManagementService Categories { get; set; } = null!;

    private readonly CategoryFormModel _model = new();
    private bool _saving;
    private string? _saveError;

    private async Task SaveAsync()
    {
        _saving = true;
        _saveError = null;
        try
        {
            if (await Categories.KeyExistsAsync(_model.Key, null))
            {
                _saveError = $"A category with key '{_model.Key}' already exists.";
                return;
            }
            var category = new SearchCategory
            {
                Key = _model.Key.Trim().ToLowerInvariant(),
                Name = _model.Name.Trim(),
                Description = string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description.Trim(),
                SortOrder = _model.SortOrder,
                Enabled = _model.Enabled
            };
            await Categories.CreateAsync(category);
            Nav.NavigateTo("/admin/categories");
        }
        catch (Exception ex)
        {
            _saveError = ex.Message;
        }
        finally { _saving = false; }
    }

    private sealed class CategoryFormModel
    {
        [Required, StringLength(80, MinimumLength = 1)]
        public string Name { get; set; } = "";
        [Required, StringLength(60, MinimumLength = 1), RegularExpression(@"^[a-z0-9][a-z0-9\-]*$", ErrorMessage = "Key must be lowercase letters, digits, and hyphens only.")]
        public string Key { get; set; } = "";
        [StringLength(500)]
        public string? Description { get; set; }
        public int SortOrder { get; set; }
        public bool Enabled { get; set; } = true;
    }
}
