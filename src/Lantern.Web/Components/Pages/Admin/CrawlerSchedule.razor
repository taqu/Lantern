@page "/admin/crawlers/{Id:guid}/schedule"
@rendermode InteractiveServer
@using Lantern.Core.Crawling
@using Lantern.Core.Jobs
@using Lantern.Crawling.Jobs
@inject CrawlerManagementService Management
@inject CrawlerJobService Jobs
@inject NavigationManager Nav

<PageTitle>Schedule · Lantern Administration</PageTitle>

@if (_loading)
{
    <p>Loading…</p>
}
else if (_notFound)
{
    <p class="alert alert-warning">Crawler not found.</p>
    <a href="/admin/crawlers">Back to crawlers</a>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin/crawlers">Crawlers</a></li>
            <li class="breadcrumb-item"><a href="/admin/crawlers/@Id">@_crawlerName</a></li>
            <li class="breadcrumb-item active">Schedule</li>
        </ol>
    </nav>

    <h1 class="h3 mb-4">Schedule — @_crawlerName</h1>

    <div class="mb-3">
        <label class="form-label fw-semibold">Schedule Type</label>
        <select class="form-select" style="max-width:280px" @bind="_typeStr">
            <option value="Disabled">Disabled</option>
            <option value="Hourly">Hourly</option>
            <option value="Daily">Daily</option>
            <option value="Weekly">Weekly</option>
        </select>
    </div>

    @if (_typeStr is "Daily" or "Weekly")
    {
        <div class="mb-3">
            <label class="form-label fw-semibold">Time of Day</label>
            <input type="time" class="form-control" style="max-width:160px"
                   value="@_timeOfDay"
                   @onchange="e => _timeOfDay = e.Value?.ToString() ?? _timeOfDay" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Time Zone</label>
            <select class="form-select" style="max-width:360px" @bind="_timeZoneId">
                @foreach (var tz in _timeZones)
                {
                    <option value="@tz.Id">@tz.DisplayName</option>
                }
            </select>
        </div>
    }

    @if (_typeStr == "Weekly")
    {
        <div class="mb-3">
            <label class="form-label fw-semibold">Days of Week</label>
            <div class="d-flex flex-wrap gap-2">
                @foreach (DayOfWeek day in Enum.GetValues<DayOfWeek>())
                {
                    bool isChecked = _daysOfWeek.Contains(day);
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="day_@day"
                               checked="@isChecked"
                               @onchange="e => ToggleDay(day, (bool)(e.Value ?? false))" />
                        <label class="form-check-label" for="day_@day">@day</label>
                    </div>
                }
            </div>
        </div>
    }

    @if (_typeStr != "Disabled" && _nextRunAt.HasValue)
    {
        <p class="text-muted small">Next run: <strong>@_nextRunAt.Value.ToLocalTime().ToString("g")</strong></p>
    }

    @if (_message != null)
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") mt-2" role="@(_messageIsError ? "alert" : "status")">
            @_message
        </div>
    }

    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">Save</button>
        <a class="btn btn-outline-secondary" href="/admin/crawlers/@Id">Cancel</a>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private string _crawlerName = "";
    private bool _loading = true;
    private bool _notFound;
    private bool _busy;
    private string? _message;
    private bool _messageIsError;

    private string _typeStr = "Disabled";
    private string _timeOfDay = "02:00";
    private string _timeZoneId = TimeZoneInfo.Local.Id;
    private List<DayOfWeek> _daysOfWeek = [];
    private DateTimeOffset? _nextRunAt;

    private static readonly IReadOnlyList<TimeZoneInfo> _timeZones =
        [.. TimeZoneInfo.GetSystemTimeZones().OrderBy(tz => tz.BaseUtcOffset)];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            CrawlerWithProfile? item = await Management.GetAsync(Id);
            if (item == null) { _notFound = true; return; }
            _crawlerName = item.Definition.Name;

            Lantern.Core.Jobs.CrawlerSchedule? schedule = await Jobs.GetScheduleAsync(Id);
            if (schedule != null)
            {
                _typeStr = schedule.Type.ToString();
                _timeOfDay = schedule.TimeOfDay?.ToString("HH:mm") ?? "02:00";
                _timeZoneId = schedule.TimeZoneId ?? TimeZoneInfo.Local.Id;
                _daysOfWeek = [.. schedule.DaysOfWeek];
                _nextRunAt = schedule.NextRunAt;
            }
        }
        catch (Exception ex)
        {
            _ = ex;
            _notFound = true;
        }
        finally { _loading = false; }
    }

    private void ToggleDay(DayOfWeek day, bool add)
    {
        if (add) { if (!_daysOfWeek.Contains(day)) _daysOfWeek.Add(day); }
        else _daysOfWeek.Remove(day);
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            ScheduleType type = Enum.TryParse<ScheduleType>(_typeStr, out ScheduleType t) ? t : ScheduleType.Disabled;
            TimeOnly? tod = (type == ScheduleType.Daily || type == ScheduleType.Weekly)
                && TimeOnly.TryParse(_timeOfDay, out TimeOnly parsed)
                ? parsed : null;

            var schedule = new Lantern.Core.Jobs.CrawlerSchedule
            {
                CrawlerId = Id,
                Enabled = type != ScheduleType.Disabled,
                Type = type,
                TimeOfDay = tod,
                TimeZoneId = _timeZoneId,
                DaysOfWeek = [.. _daysOfWeek.OrderBy(d => d)]
            };

            await Jobs.SaveScheduleAsync(schedule);
            Lantern.Core.Jobs.CrawlerSchedule? saved = await Jobs.GetScheduleAsync(Id);
            _nextRunAt = saved?.NextRunAt;

            _message = type == ScheduleType.Disabled ? "Schedule disabled." : "Schedule saved.";
            _messageIsError = false;
        }
        catch (Exception ex)
        {
            _ = ex;
            _message = "Could not save schedule.";
            _messageIsError = true;
        }
        finally { _busy = false; }
    }
}
